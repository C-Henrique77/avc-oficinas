          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "inscricoes"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"participanteId\": {{participanteId2}},\n  \"oficinaId\": {{oficinaId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5 - Conferir: a rejeicao nao alterou as vagas (continua 0)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
