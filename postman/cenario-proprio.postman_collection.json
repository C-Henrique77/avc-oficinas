          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('vagasDisponiveis continua 1 (nunca acima da capacidade)', () => { const o = pm.response.json(); pm.expect(o.vagasDisponiveis).to.eql(1); pm.expect(o.vagasDisponiveis).to.be.at.most(o.capacidade); });"
